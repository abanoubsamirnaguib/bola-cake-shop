<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # Keep backend API / admin out of the frontend rewrite
    RewriteRule ^backend(/|$) - [L]

    # If the request already points at /build/..., leave it alone
    RewriteRule ^build(/|$) - [L]

    # Serve existing files/folders from the project root as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send everything else into the React production build
    RewriteRule ^(.*)$ /build/$1 [L]
</IfModule>
