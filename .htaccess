<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # Prefer the React build as the site index
    DirectoryIndex build/index.html index.html

    # Keep backend API / admin out of the frontend rewrite
    RewriteRule ^backend(/|$) - [L]

    # Homepage → React app
    RewriteRule ^$ /build/index.html [L]

    # Requests already under /build are handled by build/.htaccess
    RewriteRule ^build(/|$) - [L]

    # Serve real files from the project root as-is
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else → React build (assets + SPA routes)
    RewriteRule ^(.*)$ /build/$1 [L]
</IfModule>
